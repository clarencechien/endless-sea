{
  "name": "endless-sea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:journey": "node tests/chapter-journey.mjs",
    "build:site": "npm run build && npm --prefix dlc/bird-forest run build && npm --prefix dlc/bird-forest run baseline && node tools/assemble-site.mjs",
    "dev:forest": "npm --prefix dlc/bird-forest run dev",
    "test:forest": "npm --prefix dlc/bird-forest test",
    "test:window": "node tools/prepare-window.mjs && node --test dlc/world-window/tests/*.test.mjs",
    "dev:window": "node tools/prepare-window.mjs && python3 -m http.server 5182 --bind 0.0.0.0 --directory dlc/world-window"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.12",
    "playwright": "^1.56.1"
  }
}
